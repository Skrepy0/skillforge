# ---------- LLM 提供商 ----------
# OpenAI 兼容接口的 API key。真实调用 LLM 时必填。
OPENAI_API_KEY=sk-your-key-here

# 兼容端点。留空使用官方端点。
# 常见配置：
#   DeepSeek:  https://api.deepseek.com/v1
#   Ollama:    http://localhost:11434/v1
#   vLLM:      http://localhost:8000/v1
OPENAI_BASE_URL=

# 模型名。OpenAICompatibleClient 读取此变量，默认 gpt-4o-mini。
# 注意：这是 LLM 侧的真实模型名；Settings.model 是引擎配置项，
# 当前只被 AppConfig 持有，不参与实际调用。两者不要混用。
SKILLFORGE_MODEL=gpt-4o-mini


# ---------- API 服务端 ----------
# /generate 的 X-API-Key 鉴权密钥。
# 未设置时：/generate 返回 401（check_ready 只在 llm 也为空时返回 503）。
# 生产环境务必设置为足够长的随机字符串，例如 openssl rand -hex 32 的输出。
SKILLFORGE_API_KEY=change-me-to-a-long-random-string

# 每分钟请求上限。默认 30；0 表示禁用（仅测试/本地用）。
# 限流 bucket 优先用 API key 的 SHA-256 哈希，无 key 时用 client host。
SKILLFORGE_RATE_LIMIT_PER_MINUTE=30

# 输出目录白名单。
# - 未设置：API 携带 out_path 的请求返回 403；CLI 不限制绝对路径
# - 设置后：API/CLI 只允许此目录内的相对 .docx 路径，
#   绝对路径、..、符号链接逃逸、超过 3 层深度一律拒绝
# CLI 也可用 --output-dir 覆盖，命令行参数优先于本变量。
SKILLFORGE_OUTPUT_DIR=./outputs


# ---------- 配置覆盖（可选）----------
# 规则：SKILLFORGE_<SECTION>_<KEY>，只覆盖 config/*.yaml 中已存在的键。
# 类型按原值自动转换：int → int，float → float，bool → 1/true/yes/on。
# 未列出的键保持 YAML 中的值；环境变量不会新增配置项。

# settings.yaml
# SKILLFORGE_SETTINGS_TIMEOUT_SECONDS=120
# SKILLFORGE_SETTINGS_MAX_REWRITE_ROUNDS=2
# SKILLFORGE_SETTINGS_QUEUE_CONCURRENCY=3
# SKILLFORGE_SETTINGS_SKILLS_ROOT=skills

# routing.yaml
# SKILLFORGE_ROUTING_SIMILARITY_THRESHOLD=0.5
# SKILLFORGE_ROUTING_CLARIFY_GAP=0.1

# gates.yaml
# SKILLFORGE_GATES_PASS_THRESHOLD=0.8

# logging.yaml
# SKILLFORGE_LOGGING_LEVEL=INFO
# SKILLFORGE_LOGGING_SAMPLE_RATE=1.0
# SKILLFORGE_LOGGING_TRACE_HEADER=X-Trace-Id